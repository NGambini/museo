# Backoffice
PORT=4000

# LE MÊME que JWT_ACCESS_SECRET côté API. Le backoffice n'émet aucun jeton :
# il vérifie la signature de ceux que l'API délivre. Sans cette vérification,
# le rôle admin serait forgeable — le jeton arrive par un cookie, donc du client.
JWT_ACCESS_SECRET=change_me_access_secret
# Laisse vide pour autoriser tout compte ayant le rôle admin dans l'API.
# Sinon, liste blanche d'emails séparés par des virgules.
ALLOWED_ADMIN_EMAILS=

# API NestJS (source des URLs signées et de la génération)
API_BASE_URL=http://localhost:3000

# Base Postgres — la MÊME que celle de l'API : le backoffice édite les lignes
# directement, l'API n'exposant pas d'endpoint de mise à jour.
DB_HOST=localhost
DB_PORT=5432
DB_USER=audioguide
DB_PASSWORD=audioguide
DB_NAME=audioguide

# Google Places (autocomplétion de la page de génération).
# Peut être la même clé que celle de l'API.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
