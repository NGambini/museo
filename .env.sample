# Backoffice
PORT=4000

# THE SAME value as the API's JWT_ACCESS_SECRET. The backoffice issues no token:
# it verifies the signature of the ones the API hands out. Without that check the
# admin role would be forgeable — the token arrives from a cookie, so from the
# client.
JWT_ACCESS_SECRET=change_me_access_secret
# Leave empty to allow any account holding the admin role in the API.
# Otherwise, a comma-separated allowlist of e-mail addresses.
ALLOWED_ADMIN_EMAILS=

# NestJS API (source of signed URLs and of generation)
API_BASE_URL=http://localhost:3000

# Postgres database — THE SAME as the API's: the backoffice edits rows directly,
# the API exposing no update endpoint.
DB_HOST=localhost
DB_PORT=5432
DB_USER=audioguide
DB_PASSWORD=audioguide
DB_NAME=audioguide

# Google Places (autocomplete on the generation page).
# Can be the same key as the API's.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
