{
  "name": "audioguide-backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AdminJS backoffice for the audioguide API",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "types:api": "openapi-typescript openapi.json -o src/types/api.ts",
    "types:api:fetch": "node scripts/fetch-openapi.mjs && npm run types:api",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@adminjs/design-system": "^4.1.1",
    "@adminjs/express": "^6.1.1",
    "@adminjs/typeorm": "^5.0.1",
    "adminjs": "^7.8.17",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "styled-components": "^5.3.11",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@tiptap/core": "2.1.13",
    "@tiptap/extension-blockquote": "2.1.13",
    "@tiptap/extension-bold": "2.1.13",
    "@tiptap/extension-bubble-menu": "2.1.13",
    "@tiptap/extension-bullet-list": "2.1.13",
    "@tiptap/extension-character-count": "2.1.13",
    "@tiptap/extension-code": "2.1.13",
    "@tiptap/extension-code-block": "2.1.13",
    "@tiptap/extension-document": "2.1.13",
    "@tiptap/extension-dropcursor": "2.1.13",
    "@tiptap/extension-floating-menu": "2.1.13",
    "@tiptap/extension-gapcursor": "2.1.13",
    "@tiptap/extension-hard-break": "2.1.13",
    "@tiptap/extension-heading": "2.1.13",
    "@tiptap/extension-history": "2.1.13",
    "@tiptap/extension-horizontal-rule": "2.1.13",
    "@tiptap/extension-image": "2.1.13",
    "@tiptap/extension-italic": "2.1.13",
    "@tiptap/extension-link": "2.1.13",
    "@tiptap/extension-list-item": "2.1.13",
    "@tiptap/extension-ordered-list": "2.1.13",
    "@tiptap/extension-paragraph": "2.1.13",
    "@tiptap/extension-strike": "2.1.13",
    "@tiptap/extension-table": "2.1.13",
    "@tiptap/extension-table-cell": "2.1.13",
    "@tiptap/extension-table-header": "2.1.13",
    "@tiptap/extension-table-row": "2.1.13",
    "@tiptap/extension-text": "2.1.13",
    "@tiptap/extension-text-align": "2.1.13",
    "@tiptap/extension-typography": "2.1.13",
    "@tiptap/pm": "2.1.13",
    "@tiptap/react": "2.1.13",
    "@tiptap/starter-kit": "2.1.13"
  }
}
